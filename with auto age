import flet as ft
from datetime import datetime


def main(page: ft.Page):
    page.title = "Practice For Final Hands-on"
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER
    page.vertical_alignment = ft.MainAxisAlignment.CENTER
    page.bgcolor = ft.Colors.WHITE

    # Username
    username_field = ft.TextField(
        label="Username",
        hint_text="Enter Username",
        width=250,
    )

    # Gender
    gender_field = ft.Dropdown(
        label="Gender",
        hint_text="Select Gender",
        width=250,
        options=[
            ft.dropdown.Option("Male"),
            ft.dropdown.Option("Female"),
        ],
    )

    # Age
    age_field = ft.TextField(
        label="Age",
        hint_text="Age",
        width=250,
        read_only=True,
    )

    # Result text
    result_text = ft.Text(
        "",
        size=16,
        weight=ft.FontWeight.BOLD,
    )

    # Auto-compute age
    def change_age(_):
        try:
            birthdate = datetime.strptime(
                birthdate_field.value,
                "%Y-%m-%d"
            )

            today = datetime.today()

            age = (
                today.year
                - birthdate.year
                - (
                    (today.month, today.day)
                    < (birthdate.month, birthdate.day)
                )
            )

            age_field.value = str(age)

        except ValueError:
            age_field.value = ""

        page.update()

    # Birthdate
    birthdate_field = ft.TextField(
        label="Birthdate",
        hint_text="YYYY-MM-DD",
        width=250,
        on_change=change_age,
    )

    # Save button
    def save_data(_):
        if (
            username_field.value == ""
            or gender_field.value is None
            or birthdate_field.value == ""
            or age_field.value == ""
        ):
            result_text.value = "Please complete all fields!"
            result_text.color = ft.Colors.RED
            if not username_field.isalpha():
                print("")
        else:
            result_text.value = (
                f"Saved Successfully!\n"
                f"Username: {username_field.value}\n"
                f"Gender: {gender_field.value}\n"
                f"Birthdate: {birthdate_field.value}\n"
                f"Age: {age_field.value}"
            )
            result_text.color = ft.Colors.GREEN

            print("========== USER DATA ==========")
            print("Username :", username_field.value)
            print("Gender   :", gender_field.value)
            print("Birthdate:", birthdate_field.value)
            print("Age      :", age_field.value)
            print("================================")

        page.update()

    # Exit button
    def exit_app(_):
        page.window.destroy()

    save_btn = ft.ElevatedButton(
        text="Save",
        width=120,
        on_click=save_data,
    )

    exit_btn = ft.ElevatedButton(
        text="Exit",
        width=120,
        on_click=exit_app,
    )

    page.add(
        ft.Row(
            [username_field],
            alignment=ft.MainAxisAlignment.CENTER,
        ),
        ft.Row(
            [gender_field],
            alignment=ft.MainAxisAlignment.CENTER,
        ),
        ft.Row(
            [birthdate_field],
            alignment=ft.MainAxisAlignment.CENTER,
        ),
        ft.Row(
            [age_field],
            alignment=ft.MainAxisAlignment.CENTER,
        ),
        ft.Row(
            [save_btn, exit_btn],
            alignment=ft.MainAxisAlignment.CENTER,
        ),
    )


ft.app(target=main)
